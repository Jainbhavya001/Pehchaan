# Copy to `.env` in this folder. Never commit the real `.env`.

# Postgres connection string (Neon: Dashboard -> Connection Details).
# Leave empty to run with an in-memory store (data is lost on restart).
NEON_DATABASE_URL=

# Where the Python screening engine listens (backend/, uvicorn).
PYTHON_API_URL=http://127.0.0.1:8000

# Secrets for signing session tokens and audit-log entries. Set long random values.
JWT_SECRET=
HMAC_SECRET=
