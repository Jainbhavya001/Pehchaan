# ===========================================================================
# PEHCHAAN / SIH-2026 — repository ignore rules
#
# Single source of truth. The nested SIH-2026/.gitignore and
# SIH-2026/frontend/.gitignore files were removed: every rule they carried was
# already covered here, because directory-agnostic patterns such as `.env`,
# `node_modules/`, `dist/` and `.venv/` match at any depth.
# ===========================================================================

# --- Byte-compiled / optimised Python --------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments --------------------------------------------
.venv/
venv/
env/

# --- Secrets (never commit) -------------------------------------------
.env
.env.local
.env.*.local
*.env
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/

# --- Node.js -----------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.pnpm-debug.log*

# --- Build output -------------------------------------------------------
dist/
build/
*.egg-info/
*.whl
*.egg
pip-wheel-metadata/
*.tsbuildinfo
vite.config.d.ts

# --- Logs ---------------------------------------------------------------
*.log
*.log.err
logs/

# --- Caches -------------------------------------------------------------
.cache/
.pytest_cache/
.tox/
htmlcov/
coverage/
.coverage

# --- Temporary / backup --------------------------------------------------
*.tmp
*.temp
tmp/
*.orig
*.bak
*.backup
*~
*.tgz
*.tar.gz
nul

# --- Test artifacts -------------------------------------------------------
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# --- Databases ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# --- Model weights and training output (large / regenerable) --------------
*.pth
*.onnx
*.pt
*.bin
*.model
*.weights
model_manifest.json
training/*.json
training/checkpoints/
*.metrics.json

# --- Uploads / generated ---------------------------------------------------
uploads/

# --- Profiling / Docker -----------------------------------------------------
*.prof
docker-compose.override.yml

# --- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Editor / IDE ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.settings/
.project
.classpath
*.iml
*.ipr
*.iws

# ===========================================================================
# PROJECT SPECIFIC
# ===========================================================================

# Raw source dataset. The canonical training copy lives in
# SIH-2026/backend/training/data (902 images); DATASET/ was a byte-identical
# duplicate of it and has been deleted along with its zip.
DATASET/
*.zip

# The 902 training images themselves.
SIH-2026/backend/training/data/

# Generated marketing-video output (its media is never committed).
SIH-2026/frontend/brag-output/

# Reference and demo ID documents: kept on disk, never committed.
# sample-data/README.md is tracked; everything else below it stays local.
SIH-2026/sample-data/**
!SIH-2026/sample-data/README.md

# Presentations, blank ID templates and chat images parked at the repo root.
*.pptx
*.docx
*.xlsx
*.xls
*.csv
*.pdf
4 sawal.docx
4sawal.pdf
Aadhaar_Blank_Template.docx
PAN_Card_Blank_Template.docx
Passport_Stacked_OneAboveOther.docx
Synthetic_Indian_Passport_Blank_Template.docx
BRUTAL AUDIT.docx
brutal audit.pdf
passport_template.jpeg
WhatsApp Image*.jpeg
mock_government_ids_300_entries.xlsx
Pehchaan-SIH2026-Idea-Presentation.pdf
SIH2026-IDEA-Presentation-Format.pptx
AI-POWERED PASSPORT AUTHENTICITY ENGINE*

# Status and session documents kept local by decision.
Pehchaan-Session-Report.md
SESSION-SUMMARY.md
PROJECT-STATUS.md
BIBLIOGRAPHY.md

# Windows reserved name and unexpanded-env-var accidents.
%TEMP%/
%USERPROFILE%/

# Office lock files.
~$*.pptx
~$*.docx
